{
  "apparatus": "HB",
  "codeCycle": "2025-2028",
  "fieldNotes": [
    "scope: general (all apparatus) or HB (horizontal bar specific). An HB rule replaces the general rule it overrides.",
    "measure: what the game must measure. angleDeg = degrees of deviation or bend; count = occurrences; event = happened or not; unmeasured = no numeric threshold yet.",
    "bands: sorted ascending; the highest band whose 'above' is exceeded applies. unit is 'deg', 'count', 'cm' or 'shoulderWidth'.",
    "notRecognized: the element also loses its difficulty value (NR).",
    "perOccurrence: deducted each time the error happens. capGroup + maxTotal: shared cap across rules.",
    "appliesTo: optional element filter, e.g. handstandCategory=strict.",
    "source: 'code' = taken from the Code of Points; 'game-interpretation' = our own measurable version of a rule that has no numeric threshold."
  ],
  "pending": [
    "lowAmplitudeFlight: the 20 cm 'distinct rise' margin above the bar is a starting value to tune in play.",
    "handstandCategory of I.27, III.40 and III.41 not decided yet (see needsReview in elements.json)."
  ],
  "severities": [
    { "severity": "small", "points": 0.1 },
    { "severity": "medium", "points": 0.3 },
    { "severity": "large", "points": 0.5 },
    { "severity": "fall", "points": 1.0 }
  ],
